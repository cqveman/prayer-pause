/* Palette
    Apricot Cream  #FFDAAA
    Dark Raspberry #880E48
    Hot Rose       #C61469
    Salmon         #FF9478
*/

/* --- MAIN --- */

QWidget {
    color: #fcfcfc;
    font-size: 15px;
}

QLabel#date {
    font-size: 20px;
    font-weight: bold;
}

/* --- GROUPBOX --- */

QGroupBox {
    background-color: rgba(36, 36, 35, 0.8);
    font-weight: bold;

    border: 2px solid rgba(64, 61, 57, 0.4);
    border-radius: 15px;

    padding-top: 50px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    left: 20px;
    top: 20px;

    color: #c9c9c9;
    font-weight: normal;
    letter-spacing: 1px;
}

/* --- SPINBOX --- */

QSpinBox {
    background-color: #3b3b3d;
    border-radius: 10px;
    padding: 1px 30px;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: right;

    width: 30px;
    color: #fcfcfc;

    border-left: 1px solid #5a5a5c;

    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: left;

    width: 30px;
    color: #fcfcfc;

    border-right: 1px solid #5a5a5c;

    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QSpinBox::up-arrow {
    image: url("assets/plus.svg");
    width: 15px;
    height: 12px;
}

QSpinBox::down-arrow {
    image: url("assets/minus.svg");
    width: 15px;
    height: 15px;
}

/* --- LOCKER --- */

QWidget#Locker {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #880E48,
        stop: 0.55 #880E48,
        stop: 1 #C61469
    );
}

QWidget#Locker QLabel {
    background: transparent;
}

QLabel#Title {
    color: #FF9478;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: 1px;
}

/* Monospace keeps every digit the same width, so the time doesn't jitter each second. */
QLabel#Countdown {
    color: #FFDAAA;
    font-size: 176px;
    font-weight: 600;
}

QProgressBar#Progress {
    background: rgba(255, 218, 170, 45);
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar#Progress::chunk {
    border-radius: 3px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #FF9478,
        stop: 1 #FFDAAA
    );
}
